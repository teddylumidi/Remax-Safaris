# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Server-side SMTP settings for quote enquiries. Never add these values to frontend configuration.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

