rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reviews Collection
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Authenticated users can write a review if their UID matches
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5;
                    
      // Owner can update/delete their own review, or any auth user can update helpful count
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount'])
      );
      
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
  }
}
